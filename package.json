{
	"name": "http-auth",
	"description": "Development files for the HTTP Auth plugin.",
	"version": "1.1.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/samiahmedsiddiqui/http-auth.git"
	},
	"bugs": {
		"url": "https://github.com/samiahmedsiddiqui/http-auth/issues"
	},
	"author": "Sami Ahmed Siddiqui",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"build": "node scripts/build-css.js",
		"version": "node scripts/sync-version.js && npm run build && git add http-auth.php readme.txt assets/css",
		"format:fix": "npm run format:css:fix",
		"format:css:fix": "stylelint \"assets/**/*.css\" --fix",
		"lint": "npm run lint:css",
		"lint:css": "stylelint \"assets/**/*.css\""
	},
	"devDependencies": {
		"@wordpress/stylelint-config": "27.2.0",
		"clean-css": "5.3.3",
		"stylelint": "18.0.0",
		"stylelint-scss": "7.5.0"
	}
}
